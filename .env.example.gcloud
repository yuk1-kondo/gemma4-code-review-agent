# Google Cloud Configuration
# Copy this file to .env.local and fill in your values

# Google Cloud Project Settings
GOOGLE_CLOUD_PROJECT=gemma4-code-review-agent
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
GOOGLE_CLOUD_REGION=asia-northeast1

# Gemma 4 API Configuration
GEMMA_API_KEY=your-api-key-here
GEMMA_MODEL=gemma-2-27b
GEMMA_TEMPERATURE=0.7
GEMMA_MAX_TOKENS=2048

# Agent Platform Configuration
AGENT_PLATFORM_ENDPOINT=https://asia-northeast1-aiplatform.googleapis.com
AGENT_PLATFORM_VERSION=v1

# Backend Server Configuration
BACKEND_PORT=3001
BACKEND_HOST=localhost
NODE_ENV=development

# Frontend Configuration
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001
VITE_API_TIMEOUT=30000

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Security Configuration
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Agent Configuration
SECURITY_AGENT_ENABLED=true
PERFORMANCE_AGENT_ENABLED=true
READABILITY_AGENT_ENABLED=true
TEST_AGENT_ENABLED=true

# Code Analysis Configuration
MAX_CODE_SIZE=100000
SUPPORTED_LANGUAGES=python,javascript,java,go,rust,typescript,cpp,csharp
ANALYSIS_TIMEOUT=60000

# Demo Configuration (for Google Cloud Next)
DEMO_MODE=false
DEMO_SAMPLE_CODE=true
DEMO_AUTO_PLAY=false
